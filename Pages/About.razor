@page "/about"

<PageTitle>À propos — @Site.Name</PageTitle>

<Reveal>
    <SectionHeading Eyebrow="À propos" Title="@($"Bonjour, je suis {Site.Name}")"/>
</Reveal>

<Reveal Delay="100" Class="space-y-5 text-lg leading-relaxed text-zinc-400">
        @foreach (string skill in Site.Skills) {
            <p>
                @skill
            </p>
        }
</Reveal>

<Reveal Delay="200" Class="mt-10 grid gap-4 sm:grid-cols-3">
    @foreach ((string value, string label) in _stats) {
        <div class="glass rounded-2xl p-6">
            <div class="text-3xl font-semibold text-white">@value</div>
            <div class="mt-1 text-sm text-zinc-400">@label</div>
        </div>
    }
</Reveal>

@code {

    private static readonly (string Value, string Label)[] _stats = [
        ("2", "années d'expérience"),
        ("-1", "projets livrés"),
        ("99,99%", "C# de bout en bout")
    ];

}
