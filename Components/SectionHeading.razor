<div class="mb-10 max-w-2xl">
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-violet-300/80">@Eyebrow</p>
    <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Subtitle)) {
        <p class="mt-3 text-zinc-400">@Subtitle</p>
    }
</div>

@code {

    [Parameter][EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

}
